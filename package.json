{
  "name": "utopiaintel",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "start": "next start",
    "test": "tsc --noEmit && tsx --test test/parsers.test.ts test/db.test.ts test/gains.test.ts test/thievery.test.ts test/population.test.ts test/lib.test.ts test/debug-log.test.ts test/rob.test.ts test/sorcery.test.ts test/attack.test.ts test/replay-timestamp.test.ts",
    "test:mysql": "tsc --noEmit && tsx --test test/db-mysql.test.ts",
    "replay-debug-log": "tsx scripts/replay-debug-log.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,css,md,html}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "better-sqlite3": "^12.8.0",
    "mysql2": "^3.22.3",
    "next": "^16.2.3",
    "next-axiom": "^1.10.0",
    "postcss": "^8.5.8",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "recharts": "^3.8.1",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "typescript": "6.0.2",
    "typescript-eslint": "^8.59.3"
  }
